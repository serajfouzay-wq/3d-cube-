# ---------------------------------------------------------------------------
# Sketch-to-Life provider. Leave everything unset to run against the built-in
# mock renderer (no network calls, no keys, works offline).
#
# Set SKETCH_PROVIDER to force one, or just drop in a key and it is auto-detected
# in this order: replicate -> fal -> openai -> mock.
# ---------------------------------------------------------------------------
# SKETCH_PROVIDER=replicate

# --- Replicate (ControlNet Scribble) ---
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REPLICATE_MODEL_VERSION=435061a1b5a4c1e26740464bf786efdfa9cb3a3ac488595a2de23e143fdb0117

# --- fal.ai ---
# FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FAL_MODEL=fal-ai/flux-control-lora-canny

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_IMAGE_MODEL=gpt-image-1
